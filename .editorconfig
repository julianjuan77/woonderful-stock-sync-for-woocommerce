# Estilo de archivos del plugin. Coincide con el de WordPress, que es lo que
# exige phpcs.xml: si el editor formatea distinto, PHPCS lo rechaza.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2
