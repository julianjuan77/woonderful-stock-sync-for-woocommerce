<?xml version="1.0"?>
<ruleset name="Woonderful Stock Sync">
	<description>PHPCS para Woonderful Stock Sync for WooCommerce</description>

	<file>.</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>

	<!--
		El plugin usa PSR-4: el archivo se llama como la clase (Transport/Sender.php),
		no class-sender.php. No lo exige el directorio de WordPress.org: el ruleset que
		corre Plugin Check no incluye este sniff (verificado el 2026-09-20 contra
		phpcs-rulesets/plugin-check.ruleset.xml). Ver docs/ARCHITECTURE.md §6.
	-->
	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wss_"/>
				<element value="WSS_"/>
				<element value="Woonderful\StockSync"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="woonderful-stock-sync-for-woocommerce"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
